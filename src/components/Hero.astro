---

---

<header class="bg-hero relative overflow-hidden">
  <div class="mx-auto max-w-[1180px] px-5 sm:px-8 pt-16 pb-24 relative">
    <svg class="pointer-events-none absolute -right-[6%] top-[8%] hidden w-[52%] max-w-[620px] opacity-90 md:block"
      viewBox="0 0 400 420" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M 30 20 C 90 60, 40 110, 100 150 C 160 190, 120 230, 180 260 C 230 285, 210 330, 270 360 C 310 380, 300 400, 360 410"
        fill="none" stroke="#7FA6A0" stroke-width="1.1" opacity="0.55" />
      <path class="stroke-amber" d="M 100 150 L 100 90 L 170 90 L 170 40" fill="none" stroke-width="1.3" stroke-dasharray="6 7" opacity="0.85" />
      <path class="stroke-amber" d="M 180 260 L 250 260 L 250 320 L 320 320" fill="none" stroke-width="1.3" stroke-dasharray="6 7" opacity="0.85" />
      <path class="stroke-amber" d="M 270 360 L 270 400" fill="none" stroke-width="1.3" stroke-dasharray="6 7" opacity="0.85" />

      <circle class="fill-amber animate-pulse-dot motion-safe-only" cx="100" cy="150" r="3.4" />
      <circle class="fill-amber animate-pulse-dot motion-safe-only" cx="180" cy="260" r="3.4" style="animation-delay:.6s" />
      <circle class="fill-amber animate-pulse-dot motion-safe-only" cx="270" cy="360" r="3.4" style="animation-delay:1.2s" />
      <circle class="fill-amber" cx="170" cy="40" r="2.2" />
      <circle class="fill-amber" cx="320" cy="320" r="2.2" />

      <text class="fill-mist font-mono text-[9.5px] tracking-wide" x="108" y="147">Matamá</text>
      <text class="fill-mist font-mono text-[9.5px] tracking-wide" x="188" y="257">Praza América</text>
      <text class="fill-mist font-mono text-[9.5px] tracking-wide" x="278" y="357">Casco Vello</text>
    </svg>

    <span class="mb-9 inline-flex items-center gap-2.5 rounded-full border border-foam/[0.14] px-3.5 py-[7px] font-mono text-[12.5px] uppercase tracking-[0.12em] text-mist before:content-['·'] before:text-[22px] before:leading-none before:text-amber">
      vigo · galiza
    </span>

    <h1 class="font-display font-bold leading-[0.98] tracking-tight">
      <span class="block text-amber text-[clamp(72px,12vw,168px)]">404:</span>
      <span class="block text-[clamp(40px,6.4vw,84px)] mt-1.5">
        <span class="relative inline-block text-mist">
          aburrimento
          <span aria-hidden="true" class="absolute left-[-2%] right-[-2%] top-1/2 h-[3px] -rotate-1 bg-coral"></span>
        </span>
      </span>
      <span class="block text-[clamp(40px,6.4vw,84px)] mt-1.5">non atopado.</span>
    </h1>

    <p class="mt-8 max-w-[520px] text-lg leading-relaxed text-foam/[0.86] sm:text-[19px]">
      Vigo404 é o punto de encontro de quen escribe código pola mañá e mergúllase na ría
      pola tarde. Unha comunidade para
      <b class="font-medium italic text-amber">programar</b>,
      <b class="font-medium italic text-amber">aprender</b> e
      <b class="font-medium italic text-amber">desfrutar</b>
    </p>

    <div class="mt-11 flex flex-wrap items-center gap-5">
      <a href="#unete" class="inline-block rounded-[3px] bg-amber px-6 py-[15px] font-mono text-sm font-medium text-deep-2 transition-all hover:-translate-y-px hover:bg-amber-light focus-visible:-translate-y-px focus-visible:bg-amber-light focus-visible:outline focus-visible:outline-2 focus-visible:outline-foam">
        Únete á comunidade
      </a>
      <a href="#eventos" class="border-b border-foam/[0.14] py-[15px] font-mono text-sm text-foam transition-colors hover:border-foam hover:text-amber focus-visible:border-foam focus-visible:text-amber">
        Ver o próximo evento →
      </a>
    </div>

    <div class="mt-14 flex items-center gap-2.5 font-mono text-[13px] text-mist">
      <span>&gt; cargando comunidade... +50 membros conectados</span>
      <span class="motion-safe-only inline-block h-[15px] w-2 animate-blink bg-amber"></span>
    </div>
  </div>
</header>
