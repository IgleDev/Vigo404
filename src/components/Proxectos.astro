---
import { CONFIG } from '../config/index'

const res = await fetch(
  'https://api.github.com/users/Vigo404/repos?sort=updated&direction=desc&per_page=6'
)

const allRepos = res.ok ? await res.json() : []
const repos = Array.isArray(allRepos)
  ? allRepos.filter((r) => r.name !== 'Vigo404')
  : []
---

<article class="mx-auto max-w-[1180px] px-5 py-24 sm:px-8 sm:py-28">
  <span class="mb-8 inline-flex items-center gap-2.5 rounded-full border border-foam/[0.14] px-3.5 py-[7px] font-mono text-[12.5px] uppercase tracking-[0.12em] text-mist before:content-['·'] before:text-[22px] before:leading-none before:text-amber">
    proxectos
  </span>

  <div class="max-w-[620px]">
    <h2 class="font-display text-[clamp(28px,3.6vw,38px)] font-semibold leading-tight tracking-tight">
      Isto está vivo. <span class="text-mist">Feito coa xente que forma parte diso.</span>
    </h2>
    <p class="mt-5 text-lg leading-relaxed text-foam/[0.8]">
      Vigo404 non amosa proxectos de escaparate, constrúeos coa xente
      que forma parte diso. Un GitHub compartido, ideas propostas no grupo, e
      quen queira botar unha man, bótaa.
    </p>
  </div>

  {repos.map((repo) => (
    <div class="mt-6 flex flex-col items-start gap-4 rounded-md border border-dashed border-deep-2/20 bg-white p-5 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-4">
        <span class="font-mono text-2xl text-amber">＋</span>
        <p class="font-mono text-sm leading-relaxed text-deep-2/70">
          {repo.name}<br />{repo.description ?? 'sen descrición'}
        </p>
      </div>

      <div class="flex flex-wrap gap-4">
        <a href={repo.html_url} target="_blank" rel="noopener noreferrer"
          class="rounded-[3px] bg-amber px-5 py-3 font-mono text-sm font-medium text-deep-2 transition-colors hover:bg-amber-light focus-visible:bg-amber-light focus-visible:outline focus-visible:outline-2 focus-visible:outline-deep-2">
          Ver o GitHub
        </a>
      </div>
    </div>
))}
</article>